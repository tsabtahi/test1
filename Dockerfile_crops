# CPHD crop builder: fixed 1024 x 1024 CPHD crops with geo ship labels
#   docker build -t cphd-crops .
#   docker run --rm --user $(id -u):$(id -g) \
#       -v /data3/sandbox/jhu/satlock/annotation_tool/test_aligned:/ann:ro \
#       -v /home/tabtahi/SATLOCK/dataset/cphd:/cphd:ro \
#       -v /home/tabtahi/SATLOCK/dataset/cphd_crops:/out \
#       cphd-crops --dry-run                 # then --limit 1, then no flag for everything
#   docker run --rm cphd-crops --selftest --selftest-dir /tmp/st
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install numpy==2.5.3 scipy==1.18.1 lxml==6.1.3 sarkit==1.12.0 pyproj==3.8.0

WORKDIR /app
COPY build_crops.py /app/build_crops.py
ENTRYPOINT ["python", "/app/build_crops.py", "--ann-root", "/ann", "--cphd-root", "/cphd", "--out", "/out"]
CMD []
